<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.2"
        android:text="SMRITI"
        android:textColor="#D6B26E"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:minHeight="52dp"
            android:padding="4dp"
            android:background="@drawable/widget_days_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#D6B26E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/days_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D6B26E"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#F3ECDD"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#B5AC9C"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#33D6B26E" />

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row1_days"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#D6B26E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="150dp"
            android:textColor="#F3ECDD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row1_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B5AC9C"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row2_days"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#D6B26E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="150dp"
            android:textColor="#F3ECDD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row2_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B5AC9C"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row3_days"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#D6B26E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row3_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="150dp"
            android:textColor="#F3ECDD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row3_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B5AC9C"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open Smriti to add birthdays and dates."
        android:textColor="#B5AC9C"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
