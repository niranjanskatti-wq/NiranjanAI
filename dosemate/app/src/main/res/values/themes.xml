<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DoseMate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="Theme.DoseMate.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DoseMate</item>
    </style>

    <style name="Theme.DoseMate.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
